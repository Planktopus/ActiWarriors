# Local SQLite database (the file and schema are created automatically)
DATASOURCE_URL=jdbc:sqlite:data/database.sqlite

# JWT — replace with a long random value in production
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRATION_MS=86400000

# Default administrator seeded only when the database is empty
ADMIN_EMAIL=admin@app.com
ADMIN_PASSWORD=Admin123!

# Frontend runtime API URL
NEXT_PUBLIC_API_URL=http://localhost:8080
